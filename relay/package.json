{
  "name": "souspli-relay",
  "private": true,
  "description": "relay.souspli.org — a small Nostr relay for Souspli letters, on Cloudflare Workers + one Durable Object. Standalone on purpose: deploying it never installs the desktop app.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:integration": "node test/integration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.135.0"
  }
}
